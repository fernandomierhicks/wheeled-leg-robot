# Python
__pycache__/
*.py[cod]
*.pyo
*.obj
.venv/
venv/
*.egg-info/

# CAD binary files — too large for GitHub (vendor STEPs/STLs are 65–115 MB)
# Store these locally or use Git LFS if you need version control for CAD
*.stl
*.STL
*.step
*.STEP
*.stp
*.STP
*.f3d
*.f3z

# Generated / large data files
*.npz
*.bak
data/logs/
data/test_results/
data/tuning/
data/twin/

# MuJoCo generated
*.mjb

# PlatformIO build artifacts
.pio/
.pioenvs/
.pio-build-*/

# OS
.DS_Store
Thumbs.db
desktop.ini

# SolidWorks lock files
~$*

# VSCode workspace (keep settings.json for Claude permissions)
*.code-workspace

# Secrets / local config overrides
.env
secrets.*
wifi_config.h

# Markup-sheet and free-space sidecars.  *.npz is ignored repo-wide above, but a
# markup sheet PNG is unreadable without its .npz (per-pixel part id + depth):
# that pair is what turns a mark into a millimetre.  They must travel together.
!cad/aesthetics/out/marks/**/*.npz
!cad/aesthetics/input/freespace/*.npz
